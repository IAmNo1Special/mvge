[0.014284, "o", "\r\n$ uv tool install 'git+https://github.com/IAmNo1Special/mvge#subdirectory=mvge-cli'\r\n"]
[11.626288, "o", "Installed 1 executable: mvge\r\n"]
[11.626574, "o", "\r\n$ mvge rune install openrouter-realm --confirm-python-deps\r\n"]
